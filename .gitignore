# ---- android_app (Android Studio / Gradle) ----
# Nested .gitignore files under android_app/ handle most Gradle/Android
# build output; these cover cases that could otherwise leak into git
# from the repo root.
android_app/local.properties
android_app/.gradle/
android_app/**/build/
android_app/.cxx/
android_app/.idea/
android_app/captures/
